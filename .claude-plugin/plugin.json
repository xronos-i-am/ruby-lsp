{
  "name": "ruby-lsp-hint",
  "displayName": "Ruby LSP for Claude Code",
  "version": "0.1.0",
  "description": "Declares the ruby-lsp language server and denies symbol-name text search until the session has asked the LSP tool",
  "author": { "name": "Sergei Malykh" },
  "repository": "https://github.com/xronos-i-am/ruby-lsp-hint",
  "license": "MIT",
  "keywords": ["ruby", "ruby-lsp", "lsp", "navigation", "hooks"],
  "lspServers": {
    "ruby-lsp": {
      "command": "ruby-lsp",
      "extensionToLanguage": {
        ".rb": "ruby",
        ".rake": "ruby",
        ".gemspec": "ruby",
        ".ru": "ruby",
        ".erb": "erb"
      }
    }
  },
  "hooks": "./hooks/hooks.json"
}
